NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://test_platform:replace-with-local-postgres-password@localhost:5432/test_platform
# Optional production CA trust, base64-encoded PEM. For Supabase Render deployments, see README.
# DATABASE_SSL_CA_BASE64=
# Teacher self-signup is open by default; set false to disable it.
# ENABLE_TEACHER_SIGNUP=false
# Set the exact number of trusted reverse-proxy hops when deployed behind a proxy.
# Leave unset when clients connect directly; common single-proxy setup: 1
# TRUST_PROXY=1
# Set to cf-connecting-ip only when Cloudflare supplies this header; missing or invalid values share a locked rate-limit bucket.
# CLIENT_IP_HEADER=cf-connecting-ip
# Optional comma-separated browser origins. Development defaults to Vite localhost; production defaults to none.
# CORS_ORIGINS=https://app.example.org
# Generate a private value with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional in production only. Set both values to bootstrap the first admin.
# Use a unique username and a strong password of at least 12 characters.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional Google GenAI key for AI-assisted PDF import.
# GEMINI_API_KEY=

# Optional comma-separated SHA-256 allowlists for platform-approved PDFs.
# Required for scanned/image-backed PDFs before OCR and for MATHCOUNTS files
# before import. Keep empty unless the platform administrator has confirmed
# the source rights and approved each exact file.
# PDF_APPROVED_SCANNED_SHA256=
# MATHCOUNTS_APPROVED_PDF_SHA256=
